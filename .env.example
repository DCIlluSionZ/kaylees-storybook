# Copy this file to .env and fill in your real key.
# Never commit your real .env file.

# Required: your Google AI Studio / Gemini API key.
GEMINI_API_KEY=your-gemini-api-key-here

# Text model used to write each page of the storybook.
# gemini-3.1-flash-lite is the cheapest, fastest tier and is plenty smart for
# warm picture-book prose with structured JSON output.
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite

# Image model used to illustrate each page (Gemini 2.5 Flash Image, aka
# "Nano Banana"). The Gemini 3.1 line is text-only; image generation is on
# the 2.5 track. Set ENABLE_IMAGES=false to skip image generation entirely.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
ENABLE_IMAGES=true

# How many pages per book.
BOOK_PAGES=10

# Port the server listens on.
PORT=3000
