# Copy this file to .env and fill in your real key.
# Never commit your real .env file.

# Required: your Google AI Studio / Gemini API key.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: which Gemini model to use. Defaults to gemini-3.1-flash-lite.
# gemini-3.1-flash-lite is the cheapest, fastest tier and is plenty smart for
# 40-60 word story chunks with structured JSON output.
# Step up to gemini-3-flash or gemini-3.1-pro only if you notice the writing
# getting repetitive after long sessions.
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: port the server listens on. Defaults to 3000.
PORT=3000
