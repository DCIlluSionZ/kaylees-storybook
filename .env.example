# Copy this file to .env and fill in your real key.
# Never commit your real .env file.

# Required: your Google AI Studio / Gemini API key.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: which Gemini model to use. Defaults to gemini-1.5-flash.
# gemini-1.5-flash is fast and cheap; gemini-1.5-pro is higher quality.
GEMINI_MODEL=gemini-1.5-flash

# Optional: port the server listens on. Defaults to 3000.
PORT=3000
